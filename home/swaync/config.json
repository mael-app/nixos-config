{
  "positionX": "right",
  "positionY": "top",
  "control-center-width": 400,
  "control-center-height": 720,
  "notification-window-width": 400,
  "notification-window-height": 160,
  "notification-icon-size": 48,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "notification-grouping": true,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "text-empty": "No notifications",
  "widgets": [
    "mpris",
    "volume",
    "backlight",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "mpris": {
      "align": "center",
      "autohide": false,
      "show-album-art": "always",
      "show-title": true,
      "show-artist": true,
      "show-album": false,
      "loop-carousel": false
    },
    "volume": {
      "label": "Volume",
      "show-per-app": true
    },
    "backlight": {
      "label": "Brightness"
    },
    "dnd": {
      "text": "Do not disturb"
    },
    "notifications": {
      "vexpand": true
    }
  }
}
