{
  "positionX": "right",
  "positionY": "top",
  "control-center-width": 400,
  "control-center-height": 820,
  "notification-window-width": 400,
  "notification-window-height": 160,
  "notification-icon-size": 48,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "notification-grouping": true,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "text-empty": "No notifications",
  "widgets": [
    "title",
    "buttons-grid",
    "mpris",
    "volume",
    "backlight",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Control Center",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "buttons-grid": {
      "actions": [
        { "label": "󰂯  Bluetooth", "type": "command", "command": "bluetooth-menu" },
        { "label": "󰌪  Power saver", "type": "command", "command": "powerprofilesctl set power-saver" },
        { "label": "󰾅  Balanced", "type": "command", "command": "powerprofilesctl set balanced" },
        { "label": "󰓅  Performance", "type": "command", "command": "powerprofilesctl set performance" },
        { "label": "󰀻  Mullvad on", "type": "command", "command": "mullvad connect" },
        { "label": "󰀼  Mullvad off", "type": "command", "command": "mullvad disconnect" },
        { "label": "󰝟  Mute", "type": "command", "command": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" },
        { "label": "󰂜  Do not disturb", "type": "command", "command": "swaync-client -d -sw" }
      ]
    },
    "mpris": {
      "align": "center",
      "autohide": false,
      "show-album-art": "always",
      "show-title": true,
      "show-artist": true,
      "show-album": false,
      "loop-carousel": false
    },
    "volume": {
      "label": "Volume",
      "show-per-app": true
    },
    "backlight": {
      "label": "Brightness"
    },
    "dnd": {
      "text": "Do not disturb"
    },
    "notifications": {
      "vexpand": true
    }
  }
}
