{
  config,
  lib,
  palette,
  ...
}:

# Long-running pieces of the session that Home Manager has a module for.
{
  # Lock after 5 min idle, screen off after 10 min
  services = {
    hypridle = {
      enable = true;
      settings = {
        general = {
          lock_cmd = "pidof hyprlock || hyprlock";
          before_sleep_cmd = "loginctl lock-session";
        };
        listener = [
          {
            timeout = 300;
            on-timeout = "loginctl lock-session";
          }
          {
            timeout = 600;
            on-timeout = "hyprctl dispatch 'hl.dsp.dpms({ action = \"disable\" })'";
            on-resume = "hyprctl dispatch 'hl.dsp.dpms({ action = \"enable\" })'";
          }
        ];
      };
    };

    # Clipboard history (SUPER + SHIFT + V)
    cliphist.enable = true;

    # Notification daemon. The module owns the unit, the settings and the
    # stylesheet (generated from the shared palette in swaync/style.nix).
    swaync = {
      enable = true;
      settings = lib.recursiveUpdate (lib.importJSON ./swaync/config.json) {
        # The Bluetooth helper is generated by Home Manager and therefore has
        # a store path rather than a stable executable name in PATH.
        "widget-config"."buttons-grid".actions = [
          {
            label = "󰂯  Bluetooth";
            type = "command";
            command = config.local.bluetoothMenu.command;
          }
          {
            label = "󰌪  Power saver";
            type = "command";
            command = "powerprofilesctl set power-saver";
          }
          {
            label = "󰾅  Balanced";
            type = "command";
            command = "powerprofilesctl set balanced";
          }
          {
            label = "󰓅  Performance";
            type = "command";
            command = "powerprofilesctl set performance";
          }
          {
            label = "󰀻  Mullvad on";
            type = "command";
            command = "mullvad connect";
          }
          {
            label = "󰀼  Mullvad off";
            type = "command";
            command = "mullvad disconnect";
          }
          {
            label = "󰝟  Mute";
            type = "command";
            command = "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle";
          }
          {
            label = "󰂜  Do not disturb";
            type = "command";
            command = "swaync-client -d -sw";
          }
          {
            label = "󰖙  Night light";
            type = "command";
            command = "systemctl --user is-active --quiet hyprsunset && systemctl --user stop hyprsunset || systemctl --user start hyprsunset";
          }
        ];
      };
      style = import ./swaync/style.nix { inherit palette; };
    };

    # Keep the clipboard alive after the copying window closes.
    wl-clip-persist = {
      enable = true;
      clipboardType = "regular";
    };

    # Battery and AC notifications.
    poweralertd.enable = true;

    # NetworkManager tray icon. preferStatusNotifierItems makes the module
    # pass --indicator, which is what the Waybar tray expects.
    network-manager-applet.enable = true;

    # Authentication prompts for apps asking for root (polkit)
    hyprpolkitagent.enable = true;

    # Volume / brightness on-screen popups
    swayosd.enable = true;

    # Blue-light filter: neutral by day, warming up over the evening.
    # hyprsunset interpolates between the profiles, so the shift is gradual.
    hyprsunset = {
      enable = true;
      settings = {
        profile = [
          {
            time = "8:00";
            temperature = 6500;
          }
          {
            time = "19:00";
            temperature = 4500;
          }
          {
            time = "22:00";
            temperature = 3400;
          }
        ];
      };
    };
  };

  xsession.preferStatusNotifierItems = true;
}
